# Copy to .env for local runs. No secrets belong in this file.
GATEWAY_PORT=8000
PLATFORM_NETWORK=platform
# Origin of the dlc-front container, the only browser origin allowed by CORS (Norma 5.6.4).
GATEWAY_ALLOWED_ORIGIN=http://localhost:8080
# Address or CIDR of the dlc-front container on the platform network; only it may set X-Forwarded-For.
# 127.0.0.1/32 trusts no proxy.
GATEWAY_TRUSTED_PROXY=127.0.0.1/32

# Smoke tests (tests/smoke.sh with tests/compose.smoke.yml). Values match the smoke environment.
SMOKE_PORT=18080
GATEWAY_URL=http://localhost:18080
SMOKE_ORIGIN=http://localhost:8080
GATEWAY_CONTAINER=dlc-smoke-gateway
SMOKE_STUB_CONTAINER=dlc-smoke-patients-api
SMOKE_STOP_CONTAINER=dlc-smoke-auth-service
SMOKE_PROXY_PORT=18081
SMOKE_PROXY_URL=http://localhost:18081
